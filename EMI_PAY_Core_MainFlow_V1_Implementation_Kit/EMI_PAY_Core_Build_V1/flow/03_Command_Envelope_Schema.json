{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMI PAY Core Command Envelope (reference, no secrets)",
  "type": "object",
  "required": [
    "CommandKey",
    "DedupeKey",
    "CommandType",
    "State",
    "PayloadJson"
  ],
  "properties": {
    "CommandKey": {
      "type": "string",
      "minLength": 1
    },
    "DedupeKey": {
      "type": "string",
      "minLength": 1
    },
    "CommandType": {
      "enum": [
        "CREATE_REQUEST",
        "SUBMIT",
        "DECIDE",
        "CONFIRM_PAYMENT"
      ]
    },
    "RequestKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "StepInstanceKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "State": {
      "enum": [
        "NEW",
        "PROCESSING",
        "SUCCEEDED",
        "REJECTED",
        "FAILED",
        "NEEDS_RECONCILIATION"
      ]
    },
    "PayloadJson": {
      "type": "string",
      "description": "Stringified JSON, parsed separately"
    }
  },
  "additionalProperties": true
}